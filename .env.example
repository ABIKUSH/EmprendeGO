# ============================================================
# EmprendeGO — Variables de entorno requeridas en Vercel
# Copiar como .env.local para desarrollo con `vercel dev`
# NUNCA commitear el archivo real (.env.local está en .gitignore)
# ============================================================

# --- Mercado Pago ---
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=tu_secreto_webhook_mp

# --- URL pública (usada en back_urls y notification_url de MP) ---
PUBLIC_BASE_URL=https://emprendego.com.ar

# --- MercadoLibre ---
ML_APP_ID=
ML_APP_SECRET=
ML_STATE_SECRET=string_aleatorio_largo_para_firmar_state_oauth_ml

# --- Supabase (SOLO para endpoints server-side, nunca al frontend) ---
SUPABASE_URL=https://seubtijmyoahnyspvidq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role, bypasa RLS

# --- Tienda Nube ---
TN_APP_ID=tu_app_id_tiendanube
TN_CLIENT_SECRET=tu_client_secret_tiendanube
TN_STATE_SECRET=string_aleatorio_largo_para_firmar_state_oauth
